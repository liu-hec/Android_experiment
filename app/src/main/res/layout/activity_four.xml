<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">



    <LinearLayout
        android:id="@+id/topNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:layout_width="141dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_space_station" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Space Stations"
                android:textSize="15sp" />
        </LinearLayout>




        <LinearLayout
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_rocket" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Flights"
                android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="129dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_rover" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Rovers"
                android:textSize="15sp" />
        </LinearLayout>


    </LinearLayout>
<!--                第一行图片+文字-->



    <TextView
        android:id="@+id/tvDCA"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="48dp"
        android:background="@color/green"
        android:gravity="center"
        android:text="DCA"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topNav" />

    <TextView
        android:id="@+id/tvMARS"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="104dp"
        android:background="@color/green"
        android:gravity="center"
        android:text="MARS"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvDCA" />

    <ImageView
        android:id="@+id/ivArrows"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_arrows"
        app:layout_constraintBottom_toBottomOf="@+id/tvDCA"
        app:layout_constraintEnd_toStartOf="@+id/tvMARS"
        app:layout_constraintHorizontal_bias="0.571"
        app:layout_constraintStart_toEndOf="@+id/tvDCA"
        app:layout_constraintTop_toTopOf="@+id/tvDCA"
        app:layout_constraintVertical_bias="0.475" />
    <!-- 后定义组件优先级高 -->

    <TextView
        android:id="@+id/tvOneWay"
        android:layout_width="200dp"
        android:layout_height="30dp"
        android:layout_marginTop="40dp"
        android:background="@color/orange"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:text="One Way   ●"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/tvDCA"
        tools:layout_editor_absoluteX="48dp"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/tvTraveller"
        android:layout_width="96dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="36dp"
        android:background="@color/orange"
        android:gravity="center"
        android:text="1 Traveller"
        android:textColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="@+id/tvOneWay"
        app:layout_constraintTop_toBottomOf="@+id/tvOneWay" />

    <ImageView
        android:id="@+id/ivRocket"
        android:layout_width="50dp"
        android:layout_height="45dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="120dp"
        android:src="@drawable/ic_rocket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTraveller" />

    <ImageView
        android:id="@+id/ivPlanet"
        android:layout_width="108dp"
        android:layout_height="94dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="88dp"
        android:src="@drawable/ic_planet"
        app:layout_constraintStart_toEndOf="@+id/ivRocket"
        app:layout_constraintTop_toBottomOf="@+id/tvTraveller" />

    <Button
        android:id="@+id/btnDepart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/green"
        android:text="DEPART"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>